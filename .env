   # Required environment variables for PrivateGPT

   # Ollama AI service
   OLLAMA_URL=http://localhost:11434
   OLLAMA_MODEL=llama3.2

   # Database
   DATABASE_URL=sqlite:///./privategpt.db

   # Security
   SECRET_KEY=your-secret-key-change-this

   # AI generation
   AI_TEMPERATURE=0.1
   AI_MAX_TOKENS=500

   # Add any other required variables from your config/settings.py